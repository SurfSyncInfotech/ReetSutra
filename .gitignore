# ==========================================
# Root .gitignore for E-COM Project
# Covers Root, Admin, Backend, and Frontend
# ==========================================

# Dependencies (node_modules in any folder)
node_modules/
**/node_modules/

# Environment Variables (.env files)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Uploaded Media & Files
uploads/
**/uploads/
!**/uploads/.gitkeep

# Build & Distribution Outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/next/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
**/logs/

# Temporary, Cache & Scratch Files
.cache/
**/.cache/
.vite/
**/.vite/
.eslintcache
.tmp/
**/scratch/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# Database / SQLite dumps
*.sqlite
*.sqlite3
